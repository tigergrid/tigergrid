{
	"name": "tigergrid",
	"version": "1.1.0",
	"description": "The parsers behind the TigerGrid graph: Claude Code, Codex and git history as per-day activity",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/types/src/index.d.ts",
			"default": "./dist/lib/index.js"
		}
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"files": [
		"dist/lib",
		"LICENSE"
	],
	"scripts": {
		"start": "bun src/cli.ts",
		"tui": "bun src/cli.ts -i",
		"build": "bun scripts/build.ts",
		"build:lib": "bun scripts/build-lib.ts",
		"prepack": "bun run build:lib",
		"smoke": "bun scripts/smoke.ts",
		"svg": "mkdir -p out && bun src/cli.ts -w 53 --svg out/tigergrid.svg",
		"svg:all": "bun scripts/svg-all.ts",
		"json": "mkdir -p out && bun src/cli.ts -w 53 --json > out/tigergrid.json",
		"test": "bun test",
		"test:lib": "bun run build:lib && TIGERGRID_TEST_LIB=1 bun test test/lib.test.ts",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"precommit": "bun run format:check && bun run check && bun run lint && bun run test",
		"prepare": "husky",
		"typecheck": "tsgo --noEmit",
		"typecheck:legacy": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inkjs/ui": "^2.0.0",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@typescript/native-preview": "beta",
		"@xterm/headless": "^6.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"ink": "8",
		"ink-gradient": "^4.0.1",
		"prettier": "^3.9.10",
		"react": "19",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.1"
	}
}
